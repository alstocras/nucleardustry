    y: 0
    shootY: 0
    reload: 30       
    recoil: 1
    rotate: true
    bullet: {
      type: ContinuousLaserBulletType
      length: 250      
      damage: 50       
      width: 2         
      colors: [ ff0000, ffcff6, ffffff ]
    }
  }
]
