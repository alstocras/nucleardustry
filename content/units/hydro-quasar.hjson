name: "Hydro Quasar"
description: "A unit that fuses hydrogen tightly together, spitting a red-hot laser"
type: mech
constructor: UnitEntity::create
health: 200
armor: 4
speed: 2.5
hitSize: 1.5

# Weapons use vanilla-compatible bullet class inline
weapons: [
  {
    name: "quasar-laser"
    top: false
    x: 0
    y: 0
    reload: 30
    recoil: 1
    rotate: true
    bullet: {
      type: LaserBulletType   # engine-recognised class
      damage: 50
      length: 250
      width: 2
      colors: [ ff0000, ffcff6, ffffff ]
    }
  }
]
