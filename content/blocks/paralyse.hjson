type: PowerTurret
name: "Paralyse"
description: "Paralyses enemy targets using supercooled helium. Extremely long range."
size: 3
health: 550
category: turret
targetAir: false

requirements: [
  titanium/200
  silicon/150
  phase-fabric/50
  surge-alloy/75
]

research: {
  parent: chapter
  requirements: [
    silicon/5000
    titanium/6800
    phase-fabric/1500
    surge-alloy/2300
  ]
}

range: 500             # safe max
reloadTime: 10          # fires continuously
rotateSpeed: 3
shootCone: 5

consumes: {
  power: 100
  liquid: {
    liquid: liquid-helium
    amount: 2
  }
}

shootType: {
  type: ContinuousLaserBulletType
  damage: 15
  width: 2
  length: 500
  status: unmoving
  statusDuration: 180
  colors: [ fec7ab, fec7ab, ffffff ]
}
